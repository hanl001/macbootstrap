# 敏感信息模板 —— 复制到 ~/.config/macbootstrap/secrets.sh 后填入真实值。
#
#   mkdir -p ~/.config/macbootstrap
#   cp config/sh-config/secrets.sh.example ~/.config/macbootstrap/secrets.sh
#   chmod 600 ~/.config/macbootstrap/secrets.sh
#
# 该真实文件在仓库外，永不入 git；_zshenv 启动时自动 source 它。

# GitHub PAT —— 用于 devops skills UI 拉取公开 repo，绕过 60/h 匿名限流
export GITHUB_TOKEN=

# 按需补充其它密钥
# export GEMINI_API_KEY=
