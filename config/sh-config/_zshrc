export ZSH=$HOME/.oh-my-zsh

ZSH_THEME="robbyrussell"

DISABLE_AUTO_UPDATE="true"

DISABLE_AUTO_TITLE="true"

plugins=(autojump colored-man-pages extract zsh-autosuggestions zsh-syntax-highlighting)

source $ZSH/oh-my-zsh.sh

# must add for macbootstrap
source $HOME/.macbootstrap/shell-src/global/global.sh

# 密钥（GEMINI_API_KEY 等）请写进 ~/.config/macbootstrap/secrets.sh，
# 由 _zshenv 统一加载，切勿明文写在被 git 跟踪的配置里。

. "$HOME/.local/bin/env"

# Hermes Agent — ensure ~/.local/bin is on PATH
export PATH="$HOME/.local/bin:$PATH"

